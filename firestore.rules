rules_version = '2';

// 權限設計
// - 任何人：可以讀設定、大地紀錄、加分、各關即時狀態（學員頁要用）
// - 管理員：用 email/密碼登入，UID 列在下面的 adminUids，可以改所有東西
// - 關主、加分人員：匿名登入後，輸入的名字要在總控台設定的名單（staff 集合）裡，
//   通過後會有一筆 sessions/{uid}。關主只能寫、改自己那一關；名字從名單移除就立刻失效
// - 練習模式的資料放在 practice_ 開頭的集合，規則和正式資料相同
//
// 新增管理員：在 Firebase 後台 Authentication 建立帳號，把 UID 加進 adminUids，
// 然後執行 firebase deploy --only firestore:rules
//
// 修改後請執行 tools/rules-test/test.mjs 實測

service cloud.firestore {
  match /databases/{database}/documents {

    function adminUids() {
      return [
        "iViyXdvj0oeS1GCwMytDFMphsg82"   // 管理員 1
      ];
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid in adminUids();
    }

    function sessionPath() {
      return /databases/$(database)/documents/sessions/$(request.auth.uid);
    }

    // 目前登入者的身分：{ role: "d2" | "d3" | "npc", station, name }
    function me() {
      return get(sessionPath()).data;
    }

    function rosterKey(s) {
      return s.role == "npc" ? "npc" : s.role + "_" + string(s.station);
    }

    function inRoster(s) {
      let roster = /databases/$(database)/documents/staff/$(rosterKey(s));
      return exists(roster) && s.name in get(roster).data.names;
    }

    function isStaff() {
      return request.auth != null && exists(sessionPath()) && inRoster(me());
    }

    function isStationStaff() {
      return isStaff() && (me().role == "d2" || me().role == "d3");
    }

    function isBonusStaff() {
      return isStaff() && me().role == "npc";
    }

    // ---------- 全域設定：只有管理員能改 ----------
    match /settings_global/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 大地遊戲紀錄 ----------
    function validGameRecord(d) {
      return d.game == me().role
        && d.station == me().station
        && d.teams is list && d.teams.size() >= 1 && d.teams.size() <= 4
        && d.result is map;
    }

    function canCreateGameRecord() {
      return isAdmin() || (isStationStaff()
        && validGameRecord(request.resource.data)
        && request.resource.data.by == me().name);
    }

    // 修改、刪除（標記為已刪除，可復原）：只能動自己那一關的
    function canUpdateGameRecord() {
      return isAdmin() || (isStationStaff()
        && resource.data.game == me().role
        && resource.data.station == me().station
        && validGameRecord(request.resource.data));
    }

    match /records_game/{id} {
      allow read: if true;
      allow create: if canCreateGameRecord();
      allow update: if canUpdateGameRecord();
      allow delete: if isAdmin();   // 真的刪掉（清空）只有管理員可以
    }
    match /practice_records_game/{id} {
      allow read: if true;
      allow create: if canCreateGameRecord();
      allow update: if canUpdateGameRecord();
      allow delete: if isAdmin();
    }

    // ---------- 加分（計分組、牧者共用）----------
    function canCreateBonus() {
      return isAdmin() || (isBonusStaff()
        && request.resource.data.npc == me().name
        && request.resource.data.team is string
        && request.resource.data.reason is string
        && request.resource.data.val is int);
    }

    // 只能修改、刪除（標記）自己送出的加分
    function canUpdateBonus() {
      return isAdmin() || (isBonusStaff()
        && resource.data.npc == me().name
        && request.resource.data.npc == me().name
        && request.resource.data.val is int);
    }

    match /records_bonus/{id} {
      allow read: if true;
      allow create: if canCreateBonus();
      allow update: if canUpdateBonus();
      allow delete: if isAdmin();
    }
    match /practice_records_bonus/{id} {
      allow read: if true;
      allow create: if canCreateBonus();
      allow update: if canUpdateBonus();
      allow delete: if isAdmin();
    }

    // ---------- 修改紀錄：只能新增，只有管理員能看 ----------
    function canWriteAudit() {
      return isAdmin() || (isStaff() && request.resource.data.by == me().name);
    }

    match /audit/{id} {
      allow read, delete: if isAdmin();
      allow create: if canWriteAudit();
    }
    match /practice_audit/{id} {
      allow read, delete: if isAdmin();
      allow create: if canWriteAudit();
    }

    // ---------- 即時狀態：哪一關有隊伍在玩、各關目前輪次 ----------
    // 關主只能動到自己那一場、自己那一關的欄位
    function onlyMyStation(field) {
      let after = request.resource.data.get(field, {});
      let before = resource.data.get(field, {});
      let role = me().role;
      return after.diff(before).affectedKeys().hasOnly([role])
        && after.get(role, {}).diff(before.get(role, {})).affectedKeys().hasOnly([string(me().station)]);
    }

    match /state/{mode} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isStationStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "rounds"])
            && onlyMyStation("active")
            && onlyMyStation("rounds"));
    }

    // ---------- 工作人員名單（只有管理員看得到）----------
    match /staff/{key} {
      allow read, write: if isAdmin();
    }

    // ---------- 登入紀錄 ----------
    match /sessions/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["role", "station", "name", "createdAt"])
        && (request.resource.data.role == "d2" || request.resource.data.role == "d3" || request.resource.data.role == "npc")
        && request.resource.data.station is int
        && request.resource.data.name is string
        && inRoster(request.resource.data);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
  }
}
